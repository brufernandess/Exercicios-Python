# Exercício 06 - Calculando Media dos Alunos Usando If, Elif e Else
m1=float(input('Digite a primeira nota: '))
m2=float(input('Digite a segunda nota: '))

media= (m1+m2)/2

if media <= 5.0:
    print(f'\33[1;31;40mATENÇAO!!!\33[m\n'
          f'Sua média foi de {media}. E infelizmente você está \33[1;7mREPROVADO\33[m')
elif media <=7.0:
    print(f'\33[1;31;40mATENÇAO!!!\33[m\n'
          f'Sua média foi de {media}. Você está em \33[1;7mRECUPERAÇAO\33[m')
else:
    print(f'\33[1;30;42mPARABENS!!!\33[m\n'
          f'Sua média foi de {media} e voce está \33[1;7mAPROVADO.\33[m')
    